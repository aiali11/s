        function saveConfiguration() {
            const numBreaks = parseInt(document.getElementById('cfg-num-breaks').value);
            let breaksArr = [];
            for(let i=0; i<numBreaks; i++) {
                let after = parseInt(document.getElementById(`cfg-break-after-${i}`).value) || 0;
                let dur = parseInt(document.getElementById(`cfg-break-dur-${i}`).value) || 0;
                let selectedClasses = Array.from(document.querySelectorAll(`.b-chk-${i}:checked`)).map(cb => cb.value);
                breaksArr.push({ after: after, duration: dur, classes: selectedClasses });
            }

            const config = {
                schoolName: document.getElementById('cfg-school').value || "المدرسة",
                principalTitle: document.getElementById('cfg-principal-title').value,
                principalName: document.getElementById('cfg-principal').value.trim(),
                newsTicker: document.getElementById('cfg-news').value.trim(),
                startTime: document.getElementById('cfg-start').value || "07:00",
                assemblyDur: parseInt(document.getElementById('cfg-assembly-dur').value) || 0,
                lessonDur: parseInt(document.getElementById('cfg-lesson-dur').value) || 45,
                totalLessons: parseInt(document.getElementById('cfg-total-lessons').value) || 7,
                breaks: breaksArr, // تخزين المصفوفة الديناميكية الجديدة
                prayerAfter: parseInt(document.getElementById('cfg-prayer-after').value) || 0,
                prayerDur: parseInt(document.getElementById('cfg-prayer-dur').value) || 0,
                enableTable: document.getElementById('cfg-enable-table').checked,
                eduLogo: schoolConfig.eduLogo, schoolLogo: schoolConfig.schoolLogo
            };
            
            const payload = { config: config, classes: classesList, timetable: fullTimetable };
