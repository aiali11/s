        function openSettings() {
            if (document.fullscreenElement) document.exitFullscreen().catch(err => console.log(err));
            document.getElementById('main-app').classList.add('hidden'); document.getElementById('start-overlay').classList.add('hidden'); document.getElementById('settings-container').classList.remove('hidden'); populateSettingsForm();
        }

        function timeToMinutes(timeStr) { const [hrs, mins] = timeStr.split(':').map(Number); return (hrs * 60) + mins; }
        function formatTime(mins) { let h = Math.floor(mins / 60) % 24; let m = mins % 60; return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`; }

        function generateSchedule() {
            dynamicSchedule = [];
            let current = timeToMinutes(schoolConfig.startTime);
            let lessonCounter = 0; 

            if (schoolConfig.assemblyDur > 0) {
                dynamicSchedule.push({ name: "الطابور الصباحي", start: current, end: current + schoolConfig.assemblyDur, startSecs: current * 60, endSecs: (current + schoolConfig.assemblyDur) * 60, type: 'assembly', lessonIdx: -1, isBreak: false });
                current += schoolConfig.assemblyDur;
            }

            for (let i = 1; i <= schoolConfig.totalLessons; i++) {
                dynamicSchedule.push({ name: "الحصة " + ordinals[i], start: current, end: current + schoolConfig.lessonDur, startSecs: current * 60, endSecs: (current + schoolConfig.lessonDur) * 60, type: 'lesson', lessonIdx: lessonCounter, isBreak: false });
                current += schoolConfig.lessonDur;
                lessonCounter++;

                // توليد الفسح ديناميكياً بناءً على مصفوفة الفسح
                if (schoolConfig.breaks && schoolConfig.breaks.length > 0) {
                    schoolConfig.breaks.forEach((brk, idx) => {
                        if (brk.after === i && brk.duration > 0) {
                            dynamicSchedule.push({ 
                                name: "الفسحة " + ordinals[idx+1], 
                                start: current, end: current + brk.duration, 
                                startSecs: current * 60, endSecs: (current + brk.duration) * 60, 
                                type: 'break', lessonIdx: -1, isBreak: true, breakIndex: idx 
                            });
                            current += brk.duration;
                        }
                    });
                }

                if (schoolConfig.prayerAfter === i && schoolConfig.prayerDur > 0) {
                    dynamicSchedule.push({ name: "صلاة الظهر", start: current, end: current + schoolConfig.prayerDur, startSecs: current * 60, endSecs: (current + schoolConfig.prayerDur) * 60, type: 'prayer', lessonIdx: -1, isBreak: false });
                    current += schoolConfig.prayerDur;
                }
            }
            
            dynamicSchedule.sort((a, b) => a.start - b.start);
            renderSidebar(); applyLogosToHeader(); 
            
            if(schoolConfig.enableTable) { document.getElementById('live-grid-container').style.display = 'flex'; } 
            else { document.getElementById('live-grid-container').style.display = 'none'; }
            
            let title = schoolConfig.principalTitle || "إدارة";
            document.getElementById('display-principal-name').innerText = schoolConfig.principalName ? `${title}: ${schoolConfig.principalName}` : "";
        }

        function renderSidebar() {
            document.getElementById('display-school-name').innerText = schoolConfig.schoolName;
            if (schoolConfig.newsTicker) { document.getElementById('news-container').style.display = 'flex'; document.getElementById('display-news').innerText = " ★ " + schoolConfig.newsTicker + " ★ "; } else { document.getElementById('news-container').style.display = 'none'; }
            const container = document.getElementById('schedule-list'); container.innerHTML = '';
            dynamicSchedule.forEach((item, index) => {
                const div = document.createElement('div'); div.className = `schedule-item ${item.type}-item`; div.id = `item-${index}`;
                div.innerHTML = `<span>${item.name}</span> <span style="font-family: monospace;">${formatTime(item.start)} - ${formatTime(item.end)}</span>`;
                container.appendChild(div);
            });
        }

        function playChime() {
            if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            if (audioCtx.state === 'suspended') audioCtx.resume();
            function beep(freq, delay, dur) {
                const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain();
                osc.connect(gain); gain.connect(audioCtx.destination);
                osc.type = 'sine'; osc.frequency.value = freq;
                gain.gain.setValueAtTime(0.5, audioCtx.currentTime + delay);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + delay + dur);
                osc.start(audioCtx.currentTime + delay); osc.stop(audioCtx.currentTime + delay + dur);
            }
            beep(659.25, 0, 1); beep(523.25, 0.4, 1.5);
        }

        function announce(text) { playChime(); setTimeout(() => { let utterance = new SpeechSynthesisUtterance(text); utterance.lang = 'ar-SA'; utterance.rate = 0.9; window.speechSynthesis.speak(utterance); }, 1200); }

        function startSystem() {
            let elem = document.documentElement; if (elem.requestFullscreen) { elem.requestFullscreen().catch(err => console.log(err)); } else if (elem.webkitRequestFullscreen) { elem.webkitRequestFullscreen(); }
            document.getElementById('start-overlay').classList.add('hidden'); document.getElementById('main-app').classList.remove('hidden'); systemActive = true;
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            let utterance = new SpeechSynthesisUtterance("بسم الله، بدأ تشغيل النظام"); utterance.lang = 'ar-SA'; window.speechSynthesis.speak(utterance);
            generateDates(); update(); setInterval(update, 1000);
        }

        function generateDates() {
            const now = new Date(); const hijriOpts = { calendar: 'islamic-umalqura', weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', numberingSystem: 'latn' }; const gregOpts = { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', numberingSystem: 'latn' };
            document.getElementById('hijri-date').innerHTML = `<span>الهجري:</span> ${new Intl.DateTimeFormat('ar-SA-u-ca-islamic-umalqura', hijriOpts).format(now)}`; document.getElementById('greg-date').innerHTML = `<span>الميلادي:</span> ${new Intl.DateTimeFormat('ar-SA', gregOpts).format(now)}`;
        }

        function updateLiveGrid(activeItem, nextLessonOverride) {
            if(!schoolConfig.enableTable) return;
            const grid = document.getElementById('classes-grid');
            const title = document.getElementById('live-grid-title');

            if (activeItem.type === 'assembly') {
                grid.innerHTML = `<div style="grid-column: 1 / -1; text-align:center; color:#94a3b8; font-size: 2.5vw; padding-top: 2vh;">☀️ الطابور الصباحي جاري الآن</div>`;
                title.innerText = `البرنامج الصباحي`; return;
            }
            if (activeItem.type === 'prayer') {
                grid.innerHTML = `<div style="grid-column: 1 / -1; text-align:center; color:var(--prayer); font-size: 2.5vw; padding-top: 2vh;">🕌 تقام الصلاة الآن.. تقبل الله طاعتكم</div>`;
                title.innerText = `وقت الصلاة`; return;
            }

            let displayIdx = activeItem.lessonIdx;
            let isBreak = activeItem.isBreak; 
            
            if (isBreak) {
                if (nextLessonOverride) {
                    displayIdx = nextLessonOverride.lessonIdx;
                } else {
                    grid.innerHTML = `<div style="grid-column: 1 / -1; text-align:center; color:#94a3b8; font-size: 2.5vw; padding-top: 2vh;">انتهاء الحصص 🎒</div>`;
                    title.innerText = `نهاية اليوم الدراسي`; return;
                }
            }

            let today = new Date().getDay();
            let saudiDayMap = { 0:0, 1:1, 2:2, 3:3, 4:4 }; 
            let dayIdx = saudiDayMap[today];
            
            if(dayIdx === undefined) { 
                grid.innerHTML = `<div style="grid-column: 1 / -1; text-align:center; color:#94a3b8; font-size: 2.5vw; padding-top: 2vh;">عطلة نهاية الأسبوع</div>`;
                title.innerText = `عطلة سعيدة`; return; 
            } 

            let breakClassesArray = [];
            if(isBreak && schoolConfig.breaks && schoolConfig.breaks[activeItem.breakIndex]) {
                breakClassesArray = schoolConfig.breaks[activeItem.breakIndex].classes || [];
            }

            let html = "";
            let count = 0;
            classesList.forEach(cls => {
                let pList = fullTimetable[dayIdx][cls];
                if(pList && pList[displayIdx] && pList[displayIdx].trim() !== "") {
                    count++;
                    let isThisClassOnBreak = isBreak && breakClassesArray.includes(cls);
                    
                    if(isThisClassOnBreak) {
                        html += `<div class="class-card in-break"><div class="c-name">${cls}</div><div class="c-subject">🍔 وقت الفسحة</div></div>`;
                    } else {
                        html += `<div class="class-card"><div class="c-name">${cls}</div><div class="c-subject">${pList[displayIdx]}</div></div>`;
                    }
                }
            });

            if(count === 0) { 
                grid.innerHTML = `<div style="grid-column: 1 / -1; text-align:center; color:#94a3b8; font-size: 2vw; padding-top: 2vh;">لا يوجد بيانات مدخلة لهذه الحصة في الجدول</div>`;
                title.innerText = `جدول الفصول`; return; 
            }
            
            let titleText = `جدول الفصول`;
            if(isBreak && nextLessonOverride) titleText += ` - ${nextLessonOverride.name} (مستمرة)`;
            else titleText += ` - ${activeItem.name}`;
            
            title.innerText = titleText;
            grid.innerHTML = html;
        }

        function update() {
            if (!systemActive) return;
            const now = new Date();
            const totalSecs = (now.getHours() * 3600) + (now.getMinutes() * 60) + now.getSeconds();
            document.getElementById('clock').innerText = now.toLocaleTimeString('en-US', {hour12: false});

            if (now.getDay() === 5 || now.getDay() === 6) {
                document.getElementById('main-period').innerText = "عطلة نهاية الأسبوع"; document.getElementById('live-grid-container').style.display = 'none'; return;
            } else { if(schoolConfig.enableTable) document.getElementById('live-grid-container').style.display = 'flex'; }

            let activeItem = null;
            let nextLesson = null;

            dynamicSchedule.forEach((item, index) => {
                if (totalSecs >= item.startSecs && totalSecs < item.endSecs) {
                    activeItem = item;
                    document.getElementById(`item-${index}`).classList.add('active');
                } else {
                    document.getElementById(`item-${index}`).classList.remove('active');
                    if (totalSecs >= item.endSecs) document.getElementById(`item-${index}`).classList.add('passed');
                }
            });

            const breakAlertBar = document.getElementById('break-alert-bar');

            if (activeItem) {
                let displayItem = activeItem;
                
                if (activeItem.isBreak) {
                    nextLesson = dynamicSchedule.find(s => s.startSecs >= activeItem.endSecs && s.type === 'lesson');
                    if (nextLesson) {
                        displayItem = {
                            name: nextLesson.name,
                            startSecs: activeItem.startSecs, 
                            endSecs: nextLesson.endSecs,     
                            type: 'lesson',
                            lessonIdx: nextLesson.lessonIdx
                        };
                    }
                }

                document.getElementById('main-period').innerText = displayItem.name;
                updateLiveGrid(activeItem, nextLesson);

                let totalDur = displayItem.endSecs - displayItem.startSecs;
                let elapsed = totalSecs - displayItem.startSecs;
                let remain = displayItem.endSecs - totalSecs;

                document.getElementById('progress-bar').style.width = `${(elapsed / totalDur) * 100}%`;
                document.getElementById('progress-percent').innerText = `${Math.floor((elapsed / totalDur) * 100)}%`;
                document.getElementById('elapsed-time').innerText = `مضى: ${String(Math.floor(elapsed / 60)).padStart(2, '0')}:${String(elapsed % 60).padStart(2, '0')}`;
                document.getElementById('main-timer').innerText = `${String(Math.floor(remain / 60)).padStart(2, '0')}:${String(remain % 60).padStart(2, '0')}`;

                if (activeItem.isBreak) {
                    let breakRemain = activeItem.endSecs - totalSecs;
                    document.getElementById('break-alert-title').innerText = `🔔 ${activeItem.name} جارية الآن للفصول المحددة`;
                    document.getElementById('break-alert-timer').innerText = `متبقي للفسحة: ${String(Math.floor(breakRemain / 60)).padStart(2, '0')}:${String(breakRemain % 60).padStart(2, '0')}`;
                    breakAlertBar.classList.remove('hidden');
                } else {
                    breakAlertBar.classList.add('hidden');
                }

                if (elapsed >= 0 && elapsed <= 2 && announcedStart !== activeItem.name) { announce(`بدأ الآن موعد ${activeItem.name}`); announcedStart = activeItem.name; }
                if (remain <= 1 && remain >= 0 && announcedEnd !== activeItem.name) { announce(`انتهى وقت ${activeItem.name}`); announcedEnd = activeItem.name; }

            } else {
                document.getElementById('main-period').innerText = "خارج الدوام";
                document.getElementById('progress-bar').style.width = "0%"; document.getElementById('progress-percent').innerText = "0%"; document.getElementById('main-timer').innerText = "--:--";
                breakAlertBar.classList.add('hidden');
                if(schoolConfig.enableTable) { document.getElementById('classes-grid').innerHTML = ""; document.getElementById('live-grid-title').innerText = "جدول الفصول"; }
            }
            if(now.getHours() === 0 && now.getMinutes() === 0 && now.getSeconds() === 0) generateDates();
        }
    </script>
</body>
</html>
