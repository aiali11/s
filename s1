                for(let p=0; p<totalL; p++) { let val = periods[p] || ""; row += `<td><input type="text" id="in_${dayIdx}_${cls}_${p}" value="${val}" placeholder="مادة - معلم" onchange="saveEditorData()"></td>`; }
